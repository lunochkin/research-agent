# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://rag:rag@localhost:5432/rag?sslmode=disable

# Generation provider: anthropic | openai
LLM_PROVIDER=openai
# anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# openai generation (if LLM_PROVIDER=openai) — reuses OPENAI_API_KEY below
OPENAI_GEN_MODEL=gpt-4o

# Embeddings — Anthropic has no native embeddings API; default OpenAI.
# Swappable: set EMBED_PROVIDER + matching key/model.
EMBED_PROVIDER=openai
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small

# Topic (config from day one — agent code stays topic-agnostic)
ARXIV_CATEGORIES=cs.AI,cs.LG
KEYWORD_FILTER=agent,LLM

# Budget (bounded loop)
MAX_ROUNDS=2
MAX_COST_USD=1.0

# Logging: debug | info | warn | error (default info). Set debug to see raw model output.
LOG_LEVEL=info
